# The profile the CI uses on Linux arm64 with musl, inside an alpine container.
#
# The arm64 side of conan/profiles/linux-musl: Conan has no setting for the C
# library, so a musl build is a plain "Linux" for it and the glibc binaries of
# conan-center would be picked, although they cannot be linked into it.
# scripts/build.mjs passes --build=* here and nothing is ever taken from the
# remote.  Keep the compiler in sync with the gcc of the alpine image of the
# workflow (alpine 3.22 ships gcc 14.2.0 on aarch64 too).
[settings]
os=Linux
arch=armv8
compiler=gcc
compiler.version=14
compiler.libcxx=libstdc++11
compiler.cppstd=20
build_type=Release

[conf]
# Without this Conan keeps the platform default generator of CMake
# (Unix Makefiles, or Xcode on macOS), which is slower on a build as large as
# the ~1300 translation units of GDAL.  GDAL is always built from source here:
# the recipe of conan/recipes/gdal carries the ExprTk and muparser options of
# the addon, so no binary of it exists on conan-center.  Ninja is installed by
# the workflow; when using this profile by hand, install it first.
tools.cmake.cmaketoolchain:generator=Ninja

[buildenv]
# Several dependencies still declare compatibility with CMake < 3.5, which
# CMake 4 rejects outright when it has to build them from source.  Only the
# environment variable is honored by those projects.
CMAKE_POLICY_VERSION_MINIMUM=3.5
